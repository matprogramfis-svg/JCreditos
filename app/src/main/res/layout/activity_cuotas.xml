<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:padding="16dp">

	<TextView
		android:id="@+id/tv_cuotas_cliente_nombre"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="Cliente: [Nombre del Cliente]"
		android:textSize="20sp"
		android:textStyle="bold"
		android:layout_marginBottom="4dp"
		android:textColor="#333333"/>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:layout_marginBottom="16dp">

		<TextView
			android:id="@+id/tv_cuotas_plan_nombre"
			android:layout_width="0dp"
			android:layout_weight="1"
			android:layout_height="wrap_content"
			android:text="Plan: [Nombre del Plan]"
			android:textSize="16sp"
			android:textColor="#666666"/>

		<TextView
			android:id="@+id/tv_saldo_pendiente"
			android:layout_width="0dp"
			android:layout_weight="1"
			android:layout_height="wrap_content"
			android:text="Saldo:"
			android:textSize="16sp"
			android:textColor="#000000"/>

	</LinearLayout>

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="Detalle de Cuotas"
		android:textSize="24sp"
		android:textStyle="bold"
		android:gravity="center"
		android:paddingBottom="16dp"/>

	<LinearLayout
		android:id="@+id/ll_total_acumulado"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:background="#E0F7FA"
		android:padding="12dp"
		android:layout_marginBottom="16dp">

		<TextView
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="Monto Total a Pagar:"
			android:textSize="18sp"
			android:textStyle="bold"
			android:textColor="#006064"/>

		<TextView
			android:id="@+id/tv_monto_acumulado"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Bs. 0.00"
			android:textSize="18sp"
			android:textStyle="bold"
			android:textColor="#006064"/>

	</LinearLayout>

	<ListView
		android:id="@+id/listview_cuotas"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:divider="#CFCFCF"
		android:dividerHeight="1dp"/>

	<Button
		android:id="@+id/btn_pagar_seleccionadas"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="Aplicar Pago"
		android:textSize="18sp"
		android:padding="14dp"
		android:layout_marginTop="16dp"/>

</LinearLayout>

