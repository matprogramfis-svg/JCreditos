<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:background="#F5F5F5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cliente (*)"
                android:textStyle="bold"
                android:textColor="#333333"/>

            <EditText
                android:id="@+id/et_cliente_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Buscar por nombre o CI..."
                android:inputType="textCapWords"
                android:padding="10dp"
                android:layout_marginBottom="8dp"/>

            <View
                android:id="@+id/separator_cliente"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Plan de Crédito (*)"
                android:textStyle="bold"
                android:textColor="#333333"/>
            <Spinner
                android:id="@+id/sp_plan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:spinnerMode="dialog"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Datos Financieros"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_capital"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Capital (Bs.)"
                    android:inputType="numberDecimal"
                    android:layout_marginEnd="8dp"/>

                <EditText
                    android:id="@+id/et_tasa_interes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Tasa (%)"
                    android:inputType="numberDecimal"/>
            </LinearLayout>

            <EditText
                android:id="@+id/et_fecha_inicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Interés Calculado:"
                android:paddingTop="4dp"/>
            <TextView
                android:id="@+id/tv_interes_monto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bs. 0.00"
                android:textSize="18sp"
                android:textStyle="italic"
                android:textColor="#FF6600"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOTAL a Pagar:"
                android:paddingTop="4dp"/>
            <TextView
                android:id="@+id/tv_total_credito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bs. 0.00"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#006600"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tv_cuotas_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Detalle de Cuotas"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btn_guardar_credito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GUARDAR CRÉDITO"/>

        </LinearLayout>
    </ScrollView>

    <ListView
        android:id="@+id/lv_sugerencias_clientes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignStart="@+id/et_cliente_nombre"
        android:layout_alignEnd="@+id/et_cliente_nombre"
        android:layout_below="@+id/et_cliente_nombre"
        android:background="@android:color/white"
        android:maxHeight="200dp"
        android:elevation="4dp"
        android:visibility="gone" />

</RelativeLayout>
